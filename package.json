{
  "name": "unemployed",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "dev": "node scripts/run-turbo.mjs dev --parallel",
    "desktop:dev": "pnpm --filter @unemployed/desktop dev",
    "build": "node scripts/run-turbo.mjs build",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "lint": "node scripts/run-turbo.mjs lint",
    "structure:check": "node scripts/check-structure.mjs",
    "source-generic:check": "node scripts/check-source-generic-discovery.mjs",
    "hotspots": "node scripts/repo-hotspots.mjs",
    "job-finder:fit-calibration": "node scripts/run-fit-calibration-benchmark.cjs --baseline packages/job-finder/test-fixtures/fit-calibration-baseline-v4.json",
    "ai:benchmark": "node packages/ai-evals/scripts/run.mjs",
    "lsp:typescript": "typescript-language-server --stdio",
    "typecheck": "node scripts/run-turbo.mjs typecheck",
    "verify:quick": "node scripts/repo-context.mjs check-docs && node scripts/check-source-generic-discovery.mjs && node scripts/check-structure.mjs && node scripts/run-turbo.mjs lint && node scripts/run-turbo.mjs typecheck",
    "verify:affected": "node scripts/repo-context.mjs check-docs && node scripts/check-source-generic-discovery.mjs && node scripts/check-structure.mjs && node scripts/run-turbo.mjs lint typecheck test --affected",
    "validate:docs-only": "node scripts/repo-context.mjs sync && node scripts/repo-context.mjs check-agents && node scripts/repo-context.mjs check-docs",
    "validate:package": "node scripts/validate-package.mjs",
    "validate:desktop": "node scripts/validate-package.mjs desktop",
    "validate:job-finder": "node scripts/validate-package.mjs job-finder",
    "validate:browser-agent": "node scripts/validate-package.mjs browser-agent",
    "validate:browser-runtime": "node scripts/validate-package.mjs browser-runtime",
    "validate:contracts": "node scripts/validate-package.mjs contracts",
    "knip": "knip",
    "test": "vitest run --exclude packages/job-finder/src/workspace-service.discovery-ledger-performance.test.ts && vitest run packages/job-finder/src/workspace-service.discovery-ledger-performance.test.ts --maxWorkers=1 --minWorkers=1",
    "test:unit": "pnpm test",
    "test:smoke": "vitest run --dir packages/contracts/src",
    "agents:sync": "node scripts/repo-context.mjs sync",
    "agents:check": "node scripts/repo-context.mjs check-agents",
    "docs:check": "node scripts/repo-context.mjs check-docs",
    "verify": "node scripts/repo-context.mjs check-agents && node scripts/repo-context.mjs check-docs && node scripts/check-source-generic-discovery.mjs && node scripts/check-structure.mjs && node scripts/run-turbo.mjs lint && node scripts/run-turbo.mjs typecheck && node scripts/run-fit-calibration-benchmark.cjs --baseline packages/job-finder/test-fixtures/fit-calibration-baseline-v4.json && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.1.4",
    "dotenv": "^16.4.7",
    "eslint": "^9.22.0",
    "globals": "^14.0.0",
    "knip": "^6.4.1",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "typescript-language-server": "^4.4.0",
    "vitest": "^3.1.4",
    "yaml": "^2.8.0"
  }
}
