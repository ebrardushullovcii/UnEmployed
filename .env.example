# Recommended mixed OpenCode Go configuration. The same Go key can serve both
# routes; keep it local and never commit it.
UNEMPLOYED_AI_API_KEY=
UNEMPLOYED_AI_BASE_URL=https://opencode.ai/zen/go/v1
UNEMPLOYED_AI_MODEL=deepseek-v4-flash
UNEMPLOYED_AI_API_MODE=chat_completions
UNEMPLOYED_AI_REASONING_EFFORT=max

# Image-only work stays on Luna High through OpenCode Go's Responses endpoint.
UNEMPLOYED_AI_VISION_BASE_URL=https://opencode.ai/zen/go/v1
UNEMPLOYED_AI_VISION_MODEL=gpt-5.6-luna
UNEMPLOYED_AI_VISION_API_MODE=responses
UNEMPLOYED_AI_VISION_REASONING_EFFORT=high

# Optional local Codex-subscription proxy for evaluation only:
# npx --yes openai-oauth@2.0.0 --host 127.0.0.1 --port 10531 --detach
# UNEMPLOYED_AI_API_KEY=unused
# UNEMPLOYED_AI_BASE_URL=http://127.0.0.1:10531/v1
# Keep Responses mode, Luna/high, and loopback-only binding. See
# docs/AI_PROVIDER_SETUP.md. Use the official OpenAI API for production.
#
# Interview Helper uses DeepSeek for cue text and Luna only for screenshots.
# Neither route transcribes audio; keep transcription on local Whisper or an
# explicit audio model.
# UNEMPLOYED_INTERVIEW_AI_MODEL=deepseek-v4-flash
# UNEMPLOYED_INTERVIEW_AI_API_MODE=chat_completions
# UNEMPLOYED_INTERVIEW_REASONING_EFFORT=max
# UNEMPLOYED_INTERVIEW_VISION_MODEL=gpt-5.6-luna
# UNEMPLOYED_INTERVIEW_VISION_API_MODE=responses
# UNEMPLOYED_INTERVIEW_VISION_REASONING_EFFORT=high

# Optional free local Interview Helper STT for microphone and system-audio chunks.
# Point the local-command provider at the wrapper below, then provide a Whisper.cpp
# executable and ggml model. Raw chunks are converted with FFmpeg, transcribed
# locally, and removed from temp storage after each provider call.
# UNEMPLOYED_INTERVIEW_LOCAL_STT_COMMAND=pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/interview-helper-local-stt.ps1 -Audio {audio} -Output {output} -Language {language} -Source {source}
# UNEMPLOYED_INTERVIEW_LOCAL_STT_LABEL=Local Whisper.cpp
# UNEMPLOYED_INTERVIEW_WHISPER_CPP_EXE=
# UNEMPLOYED_INTERVIEW_WHISPER_CPP_MODEL=
# UNEMPLOYED_FFMPEG_PATH=

# Optional: generic resume-vision provider timeout in milliseconds (default: 600000 / 10 minutes).
# The text import path still completes gracefully if the provider times out.
# UNEMPLOYED_RESUME_VISION_TIMEOUT_MS=600000
# Optional: desktop image-adapter timeout in milliseconds (default: 600000); honored by local page image generation when set.
# UNEMPLOYED_RESUME_VISION_IMAGE_TIMEOUT_MS=600000

# Browser Agent — enable live browser-assisted discovery and supported apply flows in the embedded browser
UNEMPLOYED_BROWSER_AGENT=1

# Optional: use a separate Chrome profile instead of the embedded browser
# UNEMPLOYED_BROWSER_HOST=external

# External host only: path to Chrome executable (auto-detected if unset)
# UNEMPLOYED_CHROME_PATH=

# External host only: Chrome debug port (default: 9333)
# UNEMPLOYED_CHROME_DEBUG_PORT=9333

# External host only: run Chrome headless (default: visible browser)
# UNEMPLOYED_BROWSER_HEADLESS=1
